{
  "schemaVersion": "setup-context-driven/module-v3",
  "id": "core",
  "version": 3,
  "kind": "universal",
  "title": "Upgrade contract fixture core",
  "dependsOn": [],
  "conflictsWith": [],
  "requiredSkills": ["coding-guidelines"],
  "skillDispatch": [
    {
      "skill": "coding-guidelines",
      "triggers": [
        {
          "id": "trigger.implementation.change",
          "when": "Writing or changing implementation code."
        },
        {
          "id": "trigger.implementation.review",
          "when": "Reviewing implementation code."
        }
      ]
    }
  ],
  "requiredDecisions": ["repository.extension.enabled"],
  "rootBlocks": [
    {
      "id": "root.repository-extension",
      "version": 1,
      "template": "template.root.repository-extension",
      "rules": [],
      "references": [
        {
          "id": "reference.repository-extension",
          "token": "repository.extension",
          "ownership": "repository",
          "path": "docs/agents/repository.md"
        }
      ]
    }
  ],
  "supportingGuides": [
    {
      "id": "guide.upgrade-safety",
      "version": 1,
      "path": "docs/agents/upgrade-safety.md",
      "template": "template.guide.upgrade-safety",
      "rules": ["rule.core.upgrade-safety"],
      "references": []
    }
  ],
  "rules": [
    {
      "id": "rule.core.upgrade-safety",
      "version": 3,
      "coverage": ["coverage.upgrade-safety"],
      "clauses": [
        {
          "id": "clause.core.confirm-version-transition",
          "enforcement": "stop-and-ask",
          "guidance": "Stop and ask before authorizing an incomplete version transition."
        },
        {
          "id": "clause.core.retain-hard-rules",
          "enforcement": "mandatory",
          "guidance": "Account for every previously managed hard rule."
        }
      ]
    }
  ],
  "repositoryExtensions": [
    {
      "id": "extension.repository-rules",
