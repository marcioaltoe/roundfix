{
  "schemaVersion": "setup-context-driven/module-v3",
  "id": "spec-workflow",
  "version": 3,
  "kind": "workflow",
  "title": "Local Spec workflow",
  "dependsOn": [
    "context-workflow"
  ],
  "conflictsWith": [],
  "requiredSkills": [],
  "skillDispatch": [],
  "requiredDecisions": [
    "spec.scaffold"
  ],
  "rootBlocks": [
    {
      "id": "root.spec-workflow",
      "version": 2,
      "template": "template.root.spec-workflow",
      "rules": [],
      "references": [
        {
          "id": "reference.root.spec.routing",
          "token": "reference.spec-routing",
          "ownership": "setup",
          "managedId": "guide.spec-routing"
        },
        {
          "id": "reference.root.spec.tracker",
          "token": "reference.issue-tracker",
          "ownership": "setup",
          "managedId": "guide.issue-tracker"
        }
      ]
    }
  ],
  "supportingGuides": [
    {
      "id": "guide.spec-routing",
      "version": 3,
      "path": "docs/agents/spec-routing.md",
      "template": "template.guide.spec-routing",
      "rules": [
        "rule.spec.routing"
      ],
      "references": []
    },
    {
      "id": "guide.issue-tracker",
      "version": 3,
      "path": "docs/agents/issue-tracker.md",
      "template": "template.guide.issue-tracker",
      "rules": [
        "rule.spec.artifacts"
      ],
      "references": []
    },
    {
      "id": "guide.spec-docs-layout",
      "version": 3,
      "path": "docs/agents/docs-layout.md",
      "template": "template.guide.spec-docs-layout",
      "rules": [
        "rule.spec.docs-layout"
      ],
      "references": []
    }
  ],
  "rules": [
    {
      "id": "rule.spec.routing",
      "version": 3,
      "coverage": [
        "coverage.spec-workflow"
      ],
      "clauses": [
        {
          "id": "clause.spec.routing-01-large-initiative",
          "enforcement": "mandatory",
          "guidance": "Large or fuzzy product initiative: run `write-idea` → `write-prd` → `write-techspec` → `write-tasks`."
        },
        {
          "id": "clause.spec.routing-02-standard-feature",
          "enforcement": "mandatory",
          "guidance": "Standard feature that changes product behavior: run `write-prd` → `write-techspec` → `write-tasks`; skip the TechSpec only when the feature has no architectural surface."
        },
        {
          "id": "clause.spec.routing-03-refactor-bugfix",
          "enforcement": "mandatory",
          "guidance": "Refactor or bug fix without product-behavior change: run `write-techspec` → `write-tasks` and create the minimal `_prd.md` required by the downstream artifact contract."
        },
        {
          "id": "clause.spec.routing-04-trivial-change",
          "enforcement": "mandatory",
          "guidance": "Trivial one-line fix, typo, or configuration tweak: implement directly without a Spec only when intent, acceptance criteria, and Verification are obvious."
        },
        {
          "id": "clause.spec.routing-05-task-graph",
          "enforcement": "mandatory",
          "guidance": "Use `brainstorming` before creative or feature work, start with the smaller sufficient route when two routes fit, and execute implementation from the Task Graph."
        }
      ]
    },
    {
      "id": "rule.spec.artifacts",
      "version": 3,
      "coverage": [
        "coverage.spec-workflow"
      ],
      "clauses": [
        {
          "id": "clause.spec.tracker-artifacts",
          "enforcement": "mandatory",
          "guidance": "Keep each Spec under `docs/specs/<feature-slug>/`. Dependencies live only in `_tasks.md`; status lives only in each Task file, and the local Task files are the published planning issues."
        }
      ]
    },
    {
      "id": "rule.spec.docs-layout",
      "version": 3,
      "coverage": [
        "coverage.spec-workflow"
      ],
      "clauses": [
        {
          "id": "clause.spec.keep-artifacts-in-spec-folder",
          "enforcement": "mandatory",
          "guidance": "Keep `_idea.md`, `_prd.md`, `_techspec.md`, `_tasks.md`, Task files, and `qa/` evidence under the Spec folder. Archive only completed Specs with a passing QA verdict under `docs/specs/_archived/`."
        }
      ]
    }
  ],
  "repositoryExtensions": []
}
