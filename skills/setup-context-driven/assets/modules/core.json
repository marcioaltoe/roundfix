{
  "schemaVersion": "setup-context-driven/module-v1",
  "id": "core",
  "version": 1,
  "kind": "universal",
  "title": "Universal agent instruction core",
  "dependsOn": [],
  "conflictsWith": [],
  "requiredSkills": [
    "coding-guidelines",
    "testing-boss",
    "tech-writer",
    "no-workarounds",
    "systematic-debugging",
    "evidence-gate"
  ],
  "requiredDecisions": ["language.generated"],
  "rootBlocks": [
    {
      "id": "root.core",
      "version": 1,
      "template": "template.root.core",
      "rules": [
        "rule.core.compact-root",
        "rule.core.root-cause-only",
        "rule.core.evidence-before-complete"
      ]
    }
  ],
  "supportingGuides": [
    {
      "id": "guide.agent-instructions",
      "version": 1,
      "path": "docs/agents/agent-instructions.md",
      "template": "template.guide.agent-instructions",
      "rules": [
        "rule.core.compact-root",
        "rule.core.root-cause-only",
        "rule.core.evidence-before-complete"
      ]
    }
  ],
  "rules": [
    {
      "id": "rule.core.compact-root",
      "version": 1,
      "summary": "Root agent instructions stay as mandatory pointers, not full manuals."
    },
    {
      "id": "rule.core.root-cause-only",
      "version": 1,
      "summary": "Fix root causes and do not hide signals with workarounds."
    },
    {
      "id": "rule.core.evidence-before-complete",
      "version": 1,
      "summary": "Completion claims require fresh verification evidence."
    }
  ]
}
