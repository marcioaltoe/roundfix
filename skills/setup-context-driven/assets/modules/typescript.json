      "rules": [
        "rule.typescript.current-docs",
        "rule.typescript.behavior-tests"
      ],
      "references": []
    }
  ],
  "rules": [
    {
      "id": "rule.typescript.current-docs",
      "version": 3,
      "coverage": [
        "coverage.typescript",
        "coverage.research",
        "coverage.dependencies"
      ],
      "clauses": [
        {
          "id": "clause.typescript.read-current-authoritative-docs",
          "enforcement": "mandatory",
          "guidance": "Use current authoritative documentation before changing TypeScript library APIs, framework configuration, runtime behavior, or dependencies."
        },
        {
          "id": "clause.typescript.keep-type-errors-visible",
          "enforcement": "mandatory",
          "guidance": "Keep type errors visible and preserve the repository's package and lockfile workflow."
        }
      ]
    },
    {
      "id": "rule.typescript.behavior-tests",
      "version": 3,
      "coverage": [
        "coverage.typescript",
        "coverage.verification-integrity"
      ],
      "clauses": [
        {
          "id": "clause.typescript.inspect-dependent-interfaces-before-tests",
          "enforcement": "mandatory",
          "guidance": "Read the dependent interfaces and their current contracts before writing or changing tests."
        },
        {
          "id": "clause.typescript.test-observable-failure-modes",
          "enforcement": "mandatory",
          "guidance": "Test observable behavior and explicit failure modes."
        },
        {
          "id": "clause.typescript.prohibit-incidental-test-oracles",
          "enforcement": "prohibited",
          "guidance": "Do not make mocks, snapshots of incidental output, private structure, or type assertions the source of correctness."
        }
      ]
    }
  ],
  "repositoryExtensions": []
