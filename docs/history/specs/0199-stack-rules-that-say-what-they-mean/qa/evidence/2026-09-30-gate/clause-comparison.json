      "guidance": {
        "clause.frontend.organize-by-system": "Organize frontend feature code by domain system. Each system exposes one public boundary while its internal components, hooks, queries, routes, and state import each other directly.",
        "clause.frontend.public-system-boundary": "Import another system through that system's public boundary instead of reaching into its internal modules.",
        "clause.frontend.read-design-contract-before-ui-work": "Read the repository-owned `DESIGN.md` before writing, modifying, or reviewing UI code, and treat it as the selected design contract.",
        "clause.frontend.test-user-visible-behavior": "Test user-visible roles, labels, text, state changes, loading, error, and empty states.",
        "clause.frontend.prohibit-incidental-ui-assertions": "Do not make component internals or incidental CSS structure the source of correctness.",
        "clause.frontend.inspect-runnable-ui": "Inspect significant local UI changes through the available browser when the target is runnable."
