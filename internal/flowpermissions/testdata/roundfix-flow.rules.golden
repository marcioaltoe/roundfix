# Roundfix Flow Command List for Codex. Written by roundfix permissions; do not edit.
# To remove it: roundfix permissions --harness codex --remove
prefix_rule(
    pattern = ["roundfix", ["archive", "attach", "cancel", "corrections", "deliver", "doctor", "events", "fetch", "follow-up", "gc", "history", "implement", "init", "migrate", "phase", "qa-report", "reconcile", "reopen", "resolve", "review", "runs", "settle", "setup", "spec", "stop", "storage", "supersede", "update", "upgrade", "watch", "window"]],
    decision = "allow",
    justification = "Roundfix Flow Command List: a roundfix command of the flow",
)
prefix_rule(
    pattern = ["git", ["archive", "cat-file", "check-ignore", "diff", "diff-tree", "grep", "ls-files", "merge-tree", "rev-list", "rev-parse", "show", "status"]],
    decision = "allow",
    justification = "Roundfix Flow Command List: a Git read the skills name",
)
prefix_rule(
    pattern = ["gh", "api"],
    decision = "allow",
    justification = "Roundfix Flow Command List: a GitHub read the skills name",
)
prefix_rule(
    pattern = ["gh", "pr", "view"],
    decision = "allow",
    justification = "Roundfix Flow Command List: a GitHub read the skills name",
)
